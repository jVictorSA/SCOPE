# Shared settings for the isolated SCOPE vLLM stack.
# Copy this file to the host-only deployment directory as .env.common,
# then replace VLLM_API_KEY with a real secret.

VLLM_IMAGE=nvcr.io/nvidia/vllm:26.08-py3
VLLM_API_KEY=replace-with-a-strong-key
HF_TOKEN=

# Host API. Keep this bound to localhost.
VLLM_HOST_PORT=8080

# Stable alias used by SCOPE. The underlying model is selected in .env.3b or .env.7b.
VLLM_SERVED_MODEL=local-model

# Conservative context and concurrency for a shared DGX Spark.
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=1
VLLM_MAX_NUM_BATCHED_TOKENS=1024

# Optional cache overrides. Defaults are relative to docker-compose.yml.
# VLLM_HF_CACHE=./data/huggingface
# VLLM_CACHE_DIR=./data/vllm
